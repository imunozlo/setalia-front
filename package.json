    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.4.5"
  },
  "lint-staged": {
    "(src)/**/*.{html,ts}": [
      "npm run format",
      "npm run lint:fix"
    ]
  }
}
