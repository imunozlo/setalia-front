{
  "name": "Setalia-app",
  "version": "1.0.0",
  "description": "Setalia",
  "author": "Iván Muñoz López",
  "license": "MIT",
  "scripts": {
    "ng-high-memory": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng",
    "start": "ng s --ssl",
    "build": "npm run ng-high-memory build",
    "build:test": "node --max_old_space_size=4048 ./node_modules/@angular/cli/bin/ng build --configuration test --base-href /kairon/",
    "build:prod": "node --max_old_space_size=4048 ./node_modules/@angular/cli/bin/ng build --configuration production --base-href /kairon/",
    "lint": "eslint \"src/app/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/app/**/*.{js,ts}\" --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json,css,scss,less,md}'",
    "build:netlify": "node --max_old_space_size=4048 ./node_modules/@angular/cli/bin/ng build --configuration production"
  },
  "dependencies": {
    "@angular/animations": "^17.3.5",
    "@angular/cdk": "17.3.5",
    "@angular/common": "^17.3.5",
    "@angular/compiler": "^17.3.5",
    "@angular/core": "^17.3.5",
    "@angular/forms": "^17.3.5",
    "@angular/google-maps": "^17.3.10",
    "@angular/platform-browser": "^17.3.5",
    "@angular/platform-browser-dynamic": "^17.3.5",
    "@angular/router": "^17.3.5",
    "@ctrl/tinycolor": "^4.2.0",
    "@delon/abc": "^17.3.1",
    "@delon/acl": "^17.3.1",
    "@delon/auth": "^17.3.1",
    "@delon/cache": "^17.3.1",
