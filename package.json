    "@delon/mock": "^17.3.1",
    "@delon/theme": "^17.3.1",
    "@delon/util": "^17.3.1",
    "@stomp/ng2-stompjs": "^8.0.0",
    "@stomp/stompjs": "^7.0.0",
    "@swimlane/ngx-charts": "^20.5.0",
    "angular-svg-icon": "^17.0.0",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "maplibre-gl": "^5.23.0",
    "moment": "^2.30.1",
    "ng-zorro-antd": "^17.4.0",
    "ng-zorro-antd-mobile": "^10.0.0",
    "ngx-editor": "^17.5.4",
    "ngx-extended-pdf-viewer": "^25.6.4",
    "ngx-mask": "^19.0.6",
